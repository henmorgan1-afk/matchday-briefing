# Copy to .env and fill in. .env is gitignored and must never be committed.
# Secret: also set as GitHub Actions secrets for .github/workflows/pipeline.yml.
FOOTBALL_DATA_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
# Not secret: "cloudflare" (the default, Workers AI's free daily allowance) or "ollama" (a local
# Ollama server, no key). pipeline.yml sets it to cloudflare.
AI_PROVIDER=
# Public by design (also committed in frontend/config.js from P2):
SUPABASE_URL=
SUPABASE_ANON_KEY=
