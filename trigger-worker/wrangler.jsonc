// Hourly trigger for the pipeline (SPEC.md Revision 22). Deploy at go-live only.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ludicrous-display-trigger",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // 20 minutes past every hour. Cloudflare cron triggers run on UTC.
  "triggers": {
    "crons": ["20 * * * *"]
  },
  // No public URL of any kind: the Worker has no fetch handler and is only run by its cron.
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs, included on Workers Free (200,000 events a day, kept 3 days).
  "observability": {
    "enabled": true
  },
  // Wrangler doesn't send usage data to Cloudflare from this project.
  "send_metrics": false
  // GITHUB_DISPATCH_TOKEN is a secret, added with `wrangler secret put` after the first deploy.
  // It's deliberately not listed under secrets.required, which would block that first deploy.
}
